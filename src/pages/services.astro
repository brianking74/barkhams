---
import Base from '../layouts/Base.astro';

const services = [
  { n: '01', title: 'SEO', desc: 'Own the search results for the terms that actually drive revenue.' },
  { n: '02', title: 'Paid Media', desc: 'Full-funnel paid campaigns managed for profitability, not clicks.' },
  { n: '03', title: 'Content Marketing', desc: 'Content that ranks, resonates and converts.' },
  { n: '04', title: 'Social Media', desc: 'A brand presence people actually want to follow.' },
  { n: '05', title: 'Email & CRM', desc: 'Lifecycle flows and automation that turn buyers into repeat revenue.' },
  { n: '06', title: 'Web & CRO', desc: 'Fast, high-converting pages and continuous testing.' },
];
---
<Base title="Services — Barkhams" description="SEO, paid media, content, social, email and CRO services from Barkhams.">
  <section class="mx-auto max-w-6xl px-6 py-20">
    <p class="text-sm uppercase tracking-widest text-accent">Services</p>
    <h1 class="mt-3 max-w-2xl font-display text-5xl font-bold md:text-6xl">Everything you need to grow. Nothing you don't.</h1>
    <div class="mt-16 space-y-px overflow-hidden rounded-2xl border border-white/10 bg-white/10">
      {services.map((s) => (
        <div class="flex gap-6 bg-ink p-8">
          <span class="font-display text-accent">{s.n}</span>
          <div>
            <h2 class="font-display text-2xl font-semibold">{s.title}</h2>
            <p class="mt-3 text-white/60">{s.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </section>
</Base>
