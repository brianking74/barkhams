---
import Base from '../layouts/Base.astro';

const services = [
{ n: '01', title: 'SEO', desc: 'Own the search results for the terms that actually drive revenue.', items: ['Technical audits & fixes', 'Keyword & content strategy', 'Authority & link building'] },
{ n: '02', title: 'Paid Media', desc: 'Full-funnel paid campaigns managed for profitability, not clicks.', items: ['Google Ads & Shopping', 'Meta & LinkedIn', 'Landing page CRO'] },
{ n: '03', title: 'Content Marketing', desc: 'Content that ranks, resonates and converts.', items: ['Editorial strategy', 'Long-form & web copy', 'Content distribution'] },
{ n: '04', title: 'Social Media', desc: 'A brand presence people actually want to follow.', items: ['Content calendars', 'Community management', 'Creator partnerships'] },
{ n: '05', title: 'Email & CRM', desc: 'The highest-ROI channel in your stack, properly run.', items: ['Lifecycle & welcome flows', 'Segmentation & automation', 'Campaign management'] },
{ n: '06', title: 'Web & CRO', desc: 'Fast, beautiful sites engineered to convert.', items: ['Landing page design', 'A/B testing programs', 'Analytics & tracking'] },
];
<Base title="Services — Barkhams" description="SEO, paid media, content, social, email and CRO services from Barkhams.">
<section class="mx-auto max-w-6xl px-6 py-20">
<p class="text-xs font-bold uppercase tracking-[0.2em] text-black/50">Services</p>
<h1 class="mt-4 font-display text-5xl font-extrabold tracking-tight md:text-7xl">What we can do for our clients.</h1>
<div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
{services.map((s) => (
<div class="rounded-2xl border border-black/10 p-8">
<span class="text-xs font-bold text-black/40">{s.n}</span>
<h2 class="mt-3 font-display text-2xl font-bold">{s.title}</h2>
<p class="mt-3 text-sm text-black/60">{s.desc}</p>
<ul class="mt-5 space-y-2 text-sm text-black/60">
{s.items.map((i) => <li class="flex gap-2"><span>→</span>{i}</li>)}
</ul>
</div>
))}
</div>
</section>
</Base>
