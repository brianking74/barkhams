---
import Base from '../layouts/Base.astro';

const services = [
  { n: '01', title: 'SEO', desc: 'Technical audits, on-page optimisation and authority building that compounds over time.' },
  { n: '02', title: 'Paid Media', desc: 'Google, Meta and LinkedIn campaigns engineered around one metric: profitable growth.' },
  { n: '03', title: 'Content Marketing', desc: 'Strategy, copy and editorial that earns attention instead of renting it.' },
  { n: '04', title: 'Social Media', desc: 'Organic content, community management and partnerships that build brand affinity.' },
  { n: '05', title: 'Email & CRM', desc: 'Lifecycle flows and automation that turn buyers into repeat revenue.' },
  { n: '06', title: 'Web & CRO', desc: 'Fast, high-converting pages and continuous testing.' },
];

const leftProjects = [
  { img: '/project1.png', tags: 'Web Design / Development', title: 'HK Drinks', url: 'https://www.hkdrinks.shop/' },
  { img: '/project3.png', tags: 'Web Design / Development', title: 'Job Tailor', url: 'https://job-tailor-pi.vercel.app/' },
];

const rightProjects = [
  { img: '/project2.png', tags: 'Web Design / Development', title: 'Performance Review', url: 'https://performance-review.netlify.app' },
  { img: '/project4.png', tags: 'Web Design / Development', title: '28one', url: 'https://28one.com/' },
];

// TODO: replace with a real client quote (text + name) before launch
const testimonial = {
  quote: 'Working with Barkhams transformed our online presence. Enquiries are up, the brand finally looks the part, and the reporting means we always know what is working.',
  name: 'Client name — Company',
};
---
<Base>
  <section class="mx-auto max-w-6xl px-6 pt-24 pb-16">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-black/50">Digital Marketing Agency</p>
    <h1 class="animate-wipe mt-6 font-display text-6xl font-extrabold leading-[0.95] tracking-tight md:text-8xl">
      Next generation marketing agency.
    </h1>
    <p class="mt-8 max-w-xl text-lg text-black/60">
      We help businesses develop immersive, engaging brand experiences that drive top-level growth. Strategy-first, data-backed, and allergic to vanity metrics.
    </p>
    <div class="mt-10 flex flex-wrap gap-4">
      <a href="/services" class="rounded-full bg-ink px-7 py-3 text-sm font-semibold text-white transition hover:opacity-80">View our services</a>
      <a href="/contact" class="rounded-full border border-black/20 px-7 py-3 text-sm font-semibold transition hover:border-black">Start a project</a>
    </div>
  </section>

  <section class="relative mt-8 md:mt-16">
    <div class="absolute inset-x-0 bottom-0 top-0 bg-accent md:top-32"></div>
    <div class="relative grid md:grid-cols-2">
      <div class="relative h-[320px] md:h-[640px]">
        <img data-wipe src="/team-photo.jpg" alt="Barkhams team member at work" class="wipe-ready absolute inset-0 h-full w-full object-cover" />
      </div>
      <div class="flex flex-col justify-center px-6 py-16 md:mt-32 md:min-h-[640px] md:py-0 md:pr-16 lg:pl-20 lg:pr-24">
        <h2 class="font-display text-4xl font-extrabold leading-[1.02] tracking-tight md:text-6xl">Unlock revenue growth for your business.</h2>
        <p class="mt-6 font-medium text-black/70">Your success is our success. We build brands through strategy, planning and unique design — then measure everything.</p>
        <p class="mt-4 font-medium text-black/70">Senior people on every account, transparent reporting, and campaigns measured against revenue — never vanity metrics.</p>
        <a href="/about" class="mt-10 inline-block w-fit border-b-2 border-black pb-1 text-sm font-bold tracking-wide">ABOUT US ↗</a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-20">
    <h2 class="text-center font-display text-4xl font-extrabold tracking-tight md:text-6xl">
      What we can do<br />for our clients.
    </h2>
    <div class="mx-auto mt-12 max-w-3xl border-t border-black/15">
      {services.map((s, i) => (
        <details class="group border-b border-black/15" open={i === 0}>
          <summary class="flex cursor-pointer list-none items-center gap-6 py-6 [&::-webkit-details-marker]:hidden">
            <span class="text-sm font-bold text-black/40">{s.n}</span>
            <span class="flex-1 font-display text-2xl font-bold md:text-3xl">{s.title}</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" /></svg>
          </summary>
          <p class="max-w-xl pb-8 text-black/60 md:ml-14">{s.desc}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="relative mt-8 md:mt-24">
    <div class="absolute inset-x-0 bottom-0 top-0 bg-black/5 md:top-40"></div>
    <div class="relative mx-auto max-w-6xl px-6 py-16 md:py-0 md:pb-24">
      <div class="grid gap-x-10 gap-y-16 md:grid-cols-2">
        <div class="space-y-16">
          {leftProjects.map((p) => (
            <a href={p.url} target="_blank" rel="noopener" class="group block">
              <div class="overflow-hidden">
                <img data-wipe src={p.img} alt={`${p.title} website`} class="wipe-ready aspect-[4/5] w-full object-cover object-top transition duration-500 group-hover:scale-105" />
              </div>
              <p class="mt-5 text-xs text-black/50">{p.tags}</p>
              <h3 class="mt-2 font-display text-2xl font-bold md:text-3xl">{p.title}</h3>
              <span class="mt-4 inline-block border-b-2 border-black pb-0.5 text-xs font-bold tracking-widest">VIEW PROJECT ↗</span>
            </a>
          ))}
        </div>
        <div class="space-y-16">
          {rightProjects.map((p) => (
            <a href={p.url} target="_blank" rel="noopener" class="group block">
              <div class="overflow-hidden">
                <img data-wipe src={p.img} alt={`${p.title} website`} class="wipe-ready aspect-[4/3] w-full object-cover object-top transition duration-500 group-hover:scale-105" />
              </div>
              <p class="mt-5 text-xs text-black/50">{p.tags}</p>
              <h3 class="mt-2 font-display text-2xl font-bold md:text-3xl">{p.title}</h3>
              <span class="mt-4 inline-block border-b-2 border-black pb-0.5 text-xs font-bold tracking-widest">VIEW PROJECT ↗</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="relative mt-8 md:mt-24">
    <div class="absolute inset-x-0 bottom-0 top-0 bg-accent md:top-32"></div>
    <div class="relative grid md:grid-cols-2">
      <div class="relative order-1 h-[320px] md:order-2 md:h-[640px]">
        <img data-wipe src="/client-photo.jpg" alt="Barkhams client" class="wipe-ready absolute inset-0 h-full w-full object-cover" />
      </div>
      <div class="order-2 flex flex-col justify-center px-6 py-16 md:order-1 md:mt-32 md:min-h-[640px] md:py-0 md:pr-16 lg:pl-24 lg:pr-20">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-black/50">Testimonials</p>
        <blockquote class="mt-6 font-display text-3xl font-extrabold leading-tight tracking-tight md:text-4xl">“{testimonial.quote}”</blockquote>
        <p class="mt-8 text-sm font-bold tracking-wide">{testimonial.name}</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-24">
    <div class="rounded-3xl bg-accent px-8 py-16 text-center md:px-16">
      <h2 class="font-display text-4xl font-extrabold tracking-tight md:text-6xl">Have a project in mind?</h2>
      <p class="mx-auto mt-4 max-w-md font-medium text-black/70">Tell us where you want to be in 12 months. We'll map the route.</p>
      <a href="/contact" class="mt-8 inline-block rounded-full bg-ink px-8 py-3 text-sm font-semibold text-white transition hover:opacity-80">Get in touch</a>
    </div>
  </section>
</Base>

<style is:global>
  @keyframes wipe-in {
    from { clip-path: inset(0 100% 0 0); }
    to { clip-path: inset(0 0 0 0); }
  }
  .animate-wipe { animation: wipe-in 1.2s cubic-bezier(0.65, 0, 0.35, 1) both; }
  .wipe-ready { clip-path: inset(0 100% 0 0); }
  .wipe-run { animation: wipe-in 1.1s cubic-bezier(0.65, 0, 0.35, 1) forwards; }
  @media (prefers-reduced-motion: reduce) {
    .animate-wipe, .wipe-ready, .wipe-run { animation: none !important; clip-path: none !important; }
  }
</style>

<script>
  const wipes = document.querySelectorAll('[data-wipe]');
  const show = (el) => el.classList.add('wipe-run');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            show(entry.target);
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.2 }
    );
    wipes.forEach((el) => io.observe(el));
  } else {
    wipes.forEach(show);
  }
</script>
