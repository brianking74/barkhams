---
import Base from '../layouts/Base.astro';
---
<Base title="About — Barkhams" description="About Barkhams, a full-service digital marketing agency.">
  <section class="mx-auto max-w-3xl px-6 py-20">
    <p class="text-sm uppercase tracking-widest text-accent">About</p>
    <h1 class="mt-3 font-display text-5xl font-bold md:text-6xl">A small team with an outsized track record.</h1>
    <p class="mt-8 text-lg leading-relaxed text-white/70">Founded to fix a simple problem: most marketing spends money making noise. We build channels that compound — search visibility, owned audiences and creative that sells.</p>
    <p class="mt-4 text-lg leading-relaxed text-white/70">Every engagement starts with the same question: what does profitable growth look like for you in 12 months? Then we work backwards from there.</p>
  </section>
</Base>
