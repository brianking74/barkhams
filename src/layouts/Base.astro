---
import '../styles/global.css';

const {
  title = 'Barkhams — Digital Marketing Agency',
  description = 'Barkhams is a full-service digital marketing agency. SEO, paid media, content and CRO that turn attention into revenue.',
} = Astro.props;

const email = 'barkhams.digital@gmail.com';
const year = new Date().getFullYear();

const navLinks = [
  { href: '/services', label: 'Services' },
  { href: '/insights', label: 'Insights' },
  { href: '/about', label: 'About' },
];

const footerNav = [
  { href: '/about', label: 'About Us' },
  { href: '/services', label: 'Services' },
  { href: '/contact', label: 'Contact', linkedin: true },
  { href: '/privacy-policy', label: 'Privacy Policy' },
  { href: '/terms', label: 'Terms & Conditions' },
];
---
<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-white font-body text-ink antialiased">
    <header class="sticky top-0 z-50 border-b border-black/10 bg-white/80 backdrop-blur">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
        <a href="/" class="flex items-center gap-2.5">
          <img src="/logo.png" alt="Barkhams logo" class="h-10 w-10" />
          <span class="font-display text-xl font-extrabold tracking-tight">Barkhams<span class="text-accent">.</span></span>
        </a>
        <nav class="hidden items-center gap-8 md:flex">
          {navLinks.map((l) => (
            <a href={l.href} class="text-sm font-medium text-black/60 transition hover:text-black">{l.label}</a>
          ))}
          <a href="/contact" class="rounded-full bg-ink px-5 py-2 text-sm font-semibold text-white transition hover:opacity-80">Get started</a>
        </nav>
        <button id="menu-btn" class="md:hidden" aria-label="Toggle menu">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
        </button>
      </div>
      <div id="mobile-menu" class="hidden border-t border-black/10 px-6 py-4 md:hidden">
        {navLinks.map((l) => (
          <a href={l.href} class="block py-2 font-medium text-black/70">{l.label}</a>
        ))}
        <a href="/contact" class="mt-2 block rounded-full bg-ink px-5 py-2 text-center font-semibold text-white">Get started</a>
      </div>
    </header>
    <main><slot /></main>
          <section class="mt-8 bg-accent md:mt-24">
      <div class="mx-auto grid max-w-6xl items-center gap-10 px-6 py-20 md:grid-cols-2 md:py-28">
        <h2 class="font-display text-4xl font-extrabold tracking-tight md:text-6xl">Let's Work Together</h2>
        <div>
          <p class="max-w-md text-black/60">We are a digital agency that helps businesses develop immersive and engaging user experiences.</p>
          <a href={`mailto:${email}`} class="mt-8 inline-block rounded-full bg-ink px-8 py-3 text-sm font-semibold text-white transition-colors hover:bg-white hover:text-ink">Let's Talk</a>
        </div>
      </div>
    </section>
    <footer class="border-t border-ink">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-6 gap-y-3 px-6 py-6">
        {footerNav.map((l) => (
          <span class="flex items-center gap-1.5">
            <a href={l.href} class="text-sm font-medium text-black/70 transition hover:text-black">{l.label}</a>
            {l.linkedin && (
              <a href="https://www.linkedin.com/company/barkhamsdigital" target="_blank" rel="noopener" aria-label="Barkhams on LinkedIn" class="text-black/70 transition hover:text-black">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/></svg>
              </a>
            )}
          </span>
        ))}
      </div>
      <div class="mx-auto max-w-6xl px-6 pb-6 text-center text-xs text-black/40">
        <p>© {year} Barkhams. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>
<script>
  document.getElementById('menu-btn')?.addEventListener('click', () =>
    document.getElementById('mobile-menu')?.classList.toggle('hidden')
  );
</script>
