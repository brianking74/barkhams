---
import Base from '../layouts/Base.astro';
---
<Base title="Contact — Barkhams" description="Start a project with Barkhams.">
  <section class="mx-auto max-w-3xl px-6 py-24 text-center">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-black/50">Contact</p>
    <h1 class="mt-4 font-display text-6xl font-extrabold tracking-tight md:text-8xl">Let's talk.</h1>
    <p class="mx-auto mt-8 max-w-md text-lg text-black/60">Tell us about your goals and we'll come back within one business day with first thoughts — not a sales script.</p>
    <a href="mailto:barkhams.digital@gmail.com" class="mt-10 inline-block rounded-full bg-ink px-8 py-3 text-sm font-semibold text-white transition hover:opacity-80">Email us</a>
  </section>
</Base>
