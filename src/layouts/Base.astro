---
import '../styles/global.css';

const {
title = 'Barkhams — Digital Marketing Agency',
description = 'Barkhams is a full-service digital marketing agency. SEO, paid media, content and CRO that turn attention into revenue.',
} = Astro.props;

const email = 'barkhams.digial@gmail.com';
const year = new Date().getFullYear();

const navLinks = [
{ href: '/services', label: 'Services' },
{ href: '/insights', label: 'Insights' },
{ href: '/about', label: 'About' },
];

const footerLinks = [
{ href: '/services', label: 'Services' },
{ href: '/insights', label: 'Insights' },
{ href: '/about', label: 'About' },
{ href: '/contact', label: 'Contact' },
];
<!doctype html>
<html lang="en" class="scroll-smooth">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
</head>
<body class="bg-white font-body text-ink antialiased">
<header class="sticky top-0 z-50 border-b border-black/10 bg-white/80 backdrop-blur">
<div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
<a href="/" class="font-display text-xl font-extrabold tracking-tight">Barkhams<span class="text-accent">.</span></a>
<nav class="hidden items-center gap-8 md:flex">
{navLinks.map((l) => (
<a href={l.href} class="text-sm font-medium text-black/60 transition hover:text-black">{l.label}</a>
))}
<a href="/contact" class="rounded-full bg-ink px-5 py-2 text-sm font-semibold text-white transition hover:opacity-80">Get started</a>
</nav>
<button id="menu-btn" class="md:hidden" aria-label="Toggle menu">
<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
</button>
</div>
<div id="mobile-menu" class="hidden border-t border-black/10 px-6 py-4 md:hidden">
{navLinks.map((l) => (
<a href={l.href} class="block py-2 font-medium text-black/70">{l.label}</a>
))}
<a href="/contact" class="mt-2 block rounded-full bg-ink px-5 py-2 text-center font-semibold text-white">Get started</a>
</div>
</header>
<main><slot /></main>
<footer class="border-t border-black/10">
<div class="mx-auto max-w-6xl px-6 py-16">
<p class="text-sm font-medium text-black/50">Have a project in mind?</p>
<a href={`mailto:${email}`} class="mt-2 block break-all font-display text-2xl font-extrabold tracking-tight transition hover:opacity-70 md:text-4xl">{email}</a>
<nav class="mt-10 flex flex-wrap gap-x-8 gap-y-2">
{footerLinks.map((l) => (
<a href={l.href} class="text-sm text-black/60 hover:text-black">{l.label}</a>
))}
</nav>
<div class="mt-12 border-t border-black/10 pt-6 text-sm text-black/40">
<p>© {year} Barkhams. All rights reserved.</p>
</div>
</div>
</footer>
</body>
</html>
<script>
document.getElementById('menu-btn')?.addEventListener('click', () =>
document.getElementById('mobile-menu')?.classList.toggle('hidden')
);
</script>
