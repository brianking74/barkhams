---
import Base from '../layouts/Base.astro';
---
<Base title="About — Barkhams" description="About Barkhams, a full-service digital marketing agency.">
<section class="mx-auto max-w-6xl px-6 py-20">
<p class="text-xs font-bold uppercase tracking-[0.2em] text-black/50">About</p>
<h1 class="mt-4 font-display text-5xl font-extrabold tracking-tight md:text-7xl">Passionate about what we do.</h1>
<div class="mt-14 grid gap-10 md:grid-cols-2">
<div class="rounded-3xl bg-accent p-10">
<h2 class="font-display text-3xl font-extrabold">We love what we do.</h2>
<p class="mt-4 font-medium text-black/70">Founded to fix a simple problem: most marketing spends money making noise. We build channels that compound — search visibility, owned audiences and creative that sells.</p>
</div>
<div>
<h2 class="font-display text-3xl font-extrabold">Why work with us.</h2>
<ul class="mt-6 space-y-4 text-black/60">
<li class="flex gap-3"><span>→</span> Senior people on every account — no handoffs to juniors.</li>
<li class="flex gap-3"><span>→</span> Transparent reporting on the metrics that matter.</li>
<li class="flex gap-3"><span>→</span> No lock-in contracts. We keep clients by performing.</li>
</ul>
</div>
</div>
</section>
</Base>
